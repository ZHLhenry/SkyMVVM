<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ThirdFragment"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_pop_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="popBack 返回上一页" />

    <Button
        android:id="@+id/btn_pop_to_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="popTo 返回到 First" />

    <Button
        android:id="@+id/btn_pop_to_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="popToRoot 返回根页面" />

    <Button
        android:id="@+id/btn_set_result_to_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="setNavResultTo 跨层返回 First 并带参" />

</LinearLayout>
